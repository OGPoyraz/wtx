{
  "name": "@ogpoyraz/wtx",
  "version": "0.1.0",
  "description": "Multi-repo git worktree manager",
  "type": "module",
  "bin": {
    "wtx": "./dist/cli.mjs"
  },
  "files": [
    "dist/cli.mjs",
    "share",
    "skills",
    "completions"
  ],
  "scripts": {
    "dev": "bun run src/index.ts --",
    "build": "bun build src/index.ts --compile --outfile dist/wtx",
    "build:npm": "bun build src/index.ts --target=node --external @opentui/core --external @opentui/react --external react --external react-reconciler --outfile dist/cli.mjs",
    "prepublishOnly": "bun run build:npm",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "git",
    "worktree",
    "monorepo",
    "multi-repo",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/OGPoyraz/wtx.git"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@opentui/core": "^0.5.6",
    "@opentui/react": "^0.5.6",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "react": "^19.2.8",
    "zod": "^4.4.3"
  },
  "license": "MIT"
}
